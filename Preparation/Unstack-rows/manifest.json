    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "Splits text fields that hold several values in one cell, such as one item per line, into one record per value, repeating the other fields.",
    "category": "Preparation",
    "subcategory": null,
    "tags": [
        "unstack",
        "split",
        "explode",
        "multi-value",
        "reshape"
    ],
    "introductoryText": "Turns a record whose text fields hold several values (for example one product per line in a cell) into one record per value. The other fields are repeated on each new record.\n\n**How to set it up**: choose the text fields to unstack and the separator between values. The default, `\\n`, splits at line breaks; `\\t` is a tab and `\\r` a carriage return; anything else is matched exactly as typed (so `, ` and `,` differ).\n\nWhen several fields are unstacked, their values are paired by position (the first product with the first quantity, and so on). A record becomes as many records as its longest list; shorter lists are filled with empty values. Records with nothing to split are kept as they are.",
    "dependencies": "",
    "options": [
        {
            "name": "textFields",
            "title": "Fields to unstack",
            "description": "Text fields holding several values each. Values in the chosen fields are paired by position.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldsCustomBlockPublicOption",
            "inputIndex": 0,
            "defaultValue": null,
            "mandatory": true,
            "fieldTypes": [
                "STRING"
            ]
        },
        {
            "name": "separator",
            "title": "Separator",
            "description": "The text between values. \\n is a line break (the default), \\t a tab, \\r a carriage return; anything else is matched exactly.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.TextCustomBlockPublicOption",
            "mandatory": true,
            "defaultValue": "\\n"
        }
    ],
    "blockOutputs": [
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "Output",
            "label": "Unstacked",
            "displayName": "Unstacked records",
            "tooltip": "One record per value in the chosen fields, with the other fields repeated."
        }
    ],
