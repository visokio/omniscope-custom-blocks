        null
    ],
    "optionsVersion": 1,
    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "Expands each start / end date range into one row per day, week, month, quarter or year, with days in each period and amounts prorated by days.",
    "category": "Preparation",
    "subcategory": "Date",
    "tags": [
        "generate rows",
        "date range",
        "prorate",
        "revenue recognition",
        "calendar",
        "visokio-agents"
    ],
    "introductoryText": "Turns each record with a start and an end date into **one row per day, week, month, quarter or year** that the range covers.\n\nEach output row carries the period label, its start and end, the **number of days of the range inside that period** and the share of the whole range. Choose amount fields to **prorate**: a 12-month contract worth 12,000 becomes a value per month weighted by days, ready for revenue recognition, budget phasing or occupancy counts.\n\n- End date inclusive (contracts, leave) or exclusive (hotel check-out, rentals)\n- Missing end dates can mean *still active* (today), a single day, or be skipped\n- Text dates are parsed, day first by default (31/01/2025)\n- Records that cannot be expanded (no start date, end before start) go to the second output with a reason\n\nWeeks run Monday to Sunday; quarters and years are calendar quarters and years.",
    "dependencies": "",
    "options": [
        {
            "name": "start_field",
            "title": "Start date",
            "description": "Date (or date text) the range starts on.",
            "groupTitle": "Date range",
