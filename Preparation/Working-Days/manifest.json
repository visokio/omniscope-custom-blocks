    "icon": "data:image/png;base64,",
    "description": "Counts working days between dates and adds working days to dates, skipping weekends and UK or US public holidays, with SLA checks.",
    "category": "Preparation",
    "subcategory": "Date",
    "tags": [
        "working days",
        "business days",
        "bank holidays",
        "sla",
        "due date",
        "networkdays",
        "calendar",
        "visokio-agents"
