    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "Turns a text field holding a JSON object into one new field per key, next to the input fields; nested objects and arrays become JSON text.",
    "category": "Preparation",
    "subcategory": "JSON",
    "tags": [
        "json",
        "expand",
        "fields",
        "semi",
        "structured",
        "parse",
        "properties"
    ],
    "introductoryText": "Reads a text field holding a JSON object in each record, such as the properties of a web event or the payload of an API response, and adds one field per top-level key.\n\n**How to set it up**: choose the field with the JSON. Keep the input fields ticked to add the new fields after them; untick to output only the new fields. Set a **prefix** (for example `json_`) when a key has the same name as an input field.\n\nKeys become fields in the order they first appear. A key whose values are all numbers becomes a number field, all true/false a yes/no field, anything else text. Nested objects and arrays are written as JSON text (use **JSON Normalise** to turn arrays into records). Records with empty text, invalid JSON or JSON that is not an object (an array or a single value) are kept, with the new fields empty; the block's message says how many.",
    "dependencies": "",
    "options": [
        {
            "name": "jsonField",
            "title": "JSON field",
            "description": "The text field holding a JSON object in each record.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldCustomBlockPublicOption",
            "mandatory": true,
            "inputIndex": 0,
            "defaultValue": null,
            "fieldTypes": [
