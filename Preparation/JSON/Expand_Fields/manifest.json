            "@visokiotype": "CustomBlockSchema.BooleanCustomBlockPublicOption",
            "defaultValue": true
        },
        {
            "name": "fieldPrefix",
            "title": "Prefix for new fields",
            "description": "Optional. Added to the start of each new field name, for example json_ (needed when a key matches an input field name).",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.TextCustomBlockPublicOption",
            "mandatory": false,
            "defaultValue": null
        }
    ],
