{
    "@visokiotype": "CustomBlockSchema.CustomBlockManifest",
    "name": "JSON Normalise",
    "scriptFilename": "script.py",
    "language": "PYTHON",
    "executableVersion": null,
    "minVersions": [
        null
    ],
    "optionsVersion": 1,
    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "Turns JSON text into a flat table: each object becomes a record and each array item a record of its own, nested objects become fields such as customer.name, and the input fields are repeated on every record.",
    "category": "Preparation",
    "subcategory": "JSON",
    "tags": [
        "json",
        "normalise",
        "table",
        "semi",
        "structured",
        "flatten",
        "arrays"
    ],
    "introductoryText": "Flattens a text field holding JSON into records and fields. A JSON object gives one record; an array of objects gives one record per item (for example one record per order line), with the input record's fields repeated on each.\n\n**How to set it up**: choose the field with the JSON. Keep the input fields ticked to repeat them on each record; untick to output only the JSON fields.\n\nThe new fields are named after the JSON field and the key (`Lines_sku`); nested objects add their keys with a dot (`Lines_options.colour`). An array item that is not an object, or JSON that is a single value, goes in a field ending `_value`. Arrays inside an item are written as JSON text. A key whose values are all numbers becomes a number field, all true/false a yes/no field, anything else text.\n\nRecords with empty text, an empty array or invalid JSON are kept once, with the JSON fields empty, when the input fields are kept (the block's message says how many had invalid JSON); otherwise they give no record.",
    "dependencies": "",
    "options": [
        {
            "name": "jsonField",
            "title": "JSON field",
            "description": "The text field holding JSON: an object, or an array of objects, in each record.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldCustomBlockPublicOption",
            "mandatory": true,
            "inputIndex": 0,
            "defaultValue": null,
            "fieldTypes": [
                "STRING"
            ]
        },
        {
            "name": "includeInput",
            "title": "Keep the input fields",
            "description": "Repeat the input fields on every record made from them, before the JSON fields. Unticked, only the JSON fields.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.BooleanCustomBlockPublicOption",
            "defaultValue": true
        }
    ],
    "blockOutputs": [
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "Output Data",
            "label": "Flattened",
            "displayName": "Flattened records",
            "tooltip": "One record per JSON object or array item, with nested keys as fields."
        }
    ],
    "docker": {
        "@visokiotype": "CustomBlockSchema.DockerCustomBlockPublicOption",
        "customBaseImage": null,
        "useCustomBaseImage": false,
        "customSystemLibraries": null,
        "installVisokioRepLibraries": false
    },
    "designLock": false,
    "apiMode": "BATCH"
}