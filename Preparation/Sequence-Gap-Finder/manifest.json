{
    "@visokiotype": "CustomBlockSchema.CustomBlockManifest",
    "name": "Sequence Gap Finder",
    "scriptFilename": "script.py",
    "language": "PYTHON",
    "executableVersion": null,
    "minVersions": [
        null
    ],
    "optionsVersion": 1,
    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "Finds missing, duplicate and out-of-order numbers in invoice, cheque or ticket sequences, per series, with a completeness summary.",
    "category": "Preparation",
    "subcategory": "Audit",
    "tags": [
        "sequence gaps",
        "completeness",
        "audit",
        "invoices",
        "duplicates",
        "controls",
        "fraud",
        "visokio-agents"
    ],
    "introductoryText": "Checks numbered documents (invoices, credit notes, cheques, purchase orders, tickets) for **missing numbers**, **duplicates** and numbers **issued out of date order**, per series: the completeness test auditors run on document sequences.\n\n- Numbers can carry a prefix (*INV-000123*): the digits at the end are the sequence number and the rest is the series, unless you give a series field\n- Gaps are listed with the missing numbers (up to a limit per gap), formatted like the originals\n- With a date field, documents dated earlier than a lower-numbered document are flagged\n- Summary per series: first and last number, expected count, missing, gaps, duplicates, out of order and completeness",
    "dependencies": "",
    "options": [
        {
            "name": "number_field",
            "title": "Document number field",
            "description": "The document number, with or without a text prefix.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldCustomBlockPublicOption",
            "mandatory": true,
            "inputIndex": 0,
            "defaultValue": null,
            "fieldTypes": []
        },
        {
            "name": "series_field",
            "title": "Series field (optional)",
            "description": "Default: the text before the digits.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldCustomBlockPublicOption",
            "mandatory": false,
            "inputIndex": 0,
            "defaultValue": null,
            "fieldTypes": []
        },
        {
            "name": "date_field",
            "title": "Document date (optional)",
            "description": "For the date order check.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldCustomBlockPublicOption",
            "mandatory": false,
            "inputIndex": 0,
            "defaultValue": null,
            "fieldTypes": []
        },
        {
            "name": "max_missing_listed",
            "title": "Missing numbers listed per gap",
            "description": "A longer gap lists this many numbers and then '...'.",
            "groupTitle": null,
            "width": "HALF",
            "@visokiotype": "CustomBlockSchema.IntegerCustomBlockPublicOption",
            "numMin": 1,
            "numMax": 10000,
            "mandatory": true,
            "defaultValue": 20,
            "showAsSlider": false
        }
    ],
    "blockOutputs": [
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "gaps",
            "label": "Gaps",
            "displayName": "Gaps",
            "tooltip": "Per gap: series, last number before, first after, missing count, missing numbers."
        },
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "problems",
            "label": "Problems",
            "displayName": "Problems",
            "tooltip": "Per problem document: duplicate number or dated before an earlier number."
        },
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "summary",
            "label": "Summary",
            "displayName": "Summary",
            "tooltip": "Per series: documents, first and last number, expected, missing, gaps, duplicates, out of order, completeness."
        }
    ],
    "docker": {
        "@visokiotype": "CustomBlockSchema.DockerCustomBlockPublicOption",
        "customBaseImage": null,
        "useCustomBaseImage": false,
        "customSystemLibraries": null,
        "installVisokioRepLibraries": false
    },
    "designLock": false,
    "apiMode": "BATCH"
}
