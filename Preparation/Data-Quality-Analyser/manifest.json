{
    "@visokiotype": "CustomBlockSchema.CustomBlockManifest",
    "name": "Data Quality Analyser",
    "scriptFilename": "script.py",
    "language": "PYTHON",
    "executableVersion": null,
    "minVersions": [
        null
    ],
    "optionsVersion": 1,
    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "Finds duplicate records, missing values and numeric outliers, and outputs an issue log, the data annotated with its issues, and a copy with missing values filled.",
    "category": "Preparation",
    "subcategory": null,
    "tags": [
        "quality",
        "prep",
        "verify",
        "check",
        "inspect",
        "data quality",
        "missing values",
        "duplicates",
        "outliers",
        "imputation"
    ],
    "introductoryText": "Checks every record of the input for three kinds of issue:\n\n- **Duplicate records**: every field the same as in another record (all copies are flagged).\n- **Missing values**: an empty value in any field.\n- **Outliers**: a number more than 1.5 times the interquartile range below the first quartile or above the third, field by field.\n\n**How to set it up**: tick the outputs you want. *Issue log* lists one record per issue; *Annotated data* is the input with the issues of each record in Issue Flags and Issue Count; *Enriched data* fills missing numbers with the field's median and missing text with its most common value, and marks the changed records in Was Enriched. Date fields are checked but not filled.\n\nEvery output starts with a **Row ID** (the record's position in the input, from 1), so the issue log can be joined back to the data. If the input already has a field with one of the block's field names, the new field gets a number (Row ID 2).",
    "dependencies": "",
    "options": [
        {
            "name": "annotateData",
            "title": "Output annotated data",
            "description": "The input with a Row ID, the issues found in each record (Issue Flags) and how many there are (Issue Count).",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.BooleanCustomBlockPublicOption",
            "defaultValue": true
        },
        {
            "name": "findIssues",
            "title": "Output issue log",
            "description": "One record per issue found: Row ID, Issue Type (DUPLICATE_ROW, MISSING_VALUE or OUTLIER), Issue Field and Issue Details.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.BooleanCustomBlockPublicOption",
            "defaultValue": true
        },
        {
            "name": "enrichData",
            "title": "Output enriched data",
            "description": "The input with missing numbers filled with the field's median and missing text with its most common value, and a Was Enriched field. Dates are not filled.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.BooleanCustomBlockPublicOption",
            "defaultValue": false
        }
    ],
    "blockOutputs": [
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "annotated",
            "label": "Annotated",
            "displayName": "Annotated data",
            "tooltip": "The input with Row ID, Issue Flags and Issue Count. Empty unless Output annotated data is ticked."
        },
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "issues",
            "label": "Issues",
            "displayName": "Issue log",
            "tooltip": "One record per issue: Row ID, Issue Type, Issue Field, Issue Details. Empty unless Output issue log is ticked."
        },
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "enriched",
            "label": "Enriched",
            "displayName": "Enriched data",
            "tooltip": "Missing numbers filled with the median, missing text with the most common value; Was Enriched marks changed records. Empty unless Output enriched data is ticked."
        }
    ],
    "docker": {
        "@visokiotype": "CustomBlockSchema.DockerCustomBlockPublicOption",
        "customBaseImage": null,
        "useCustomBaseImage": false,
        "customSystemLibraries": null,
        "installVisokioRepLibraries": false
    },
    "designLock": true,
    "apiMode": "BATCH"
}
