    "optionsVersion": 1,
    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "Percent-encodes the text in a field (UTF-8) into a new field, so it can go into a link, a query string or a web request.",
    "category": "Preparation",
    "subcategory": null,
    "tags": [
        "url",
        "quote",
        "encode",
        "percent-encoding",
        "link",
        "query string"
    ],
    "introductoryText": "Percent-encodes the text in one field into a new field, using UTF-8: spaces, accented letters, currency signs and characters with a meaning in URLs (`?`, `&`, `=`, `#`, `+`) become `%` codes, so the text can be put into a link or a web request safely. Letters, digits and `_ . - ~` are left as they are.\n\n**How to set it up**: choose the field to encode and a name for the new field.\n\n- **Encode slashes**: tick when the text goes into one part of a path or a query value that must not contain `/` (unticked, `/` is kept, so whole paths stay readable).\n- **Spaces as +**: tick for form-style query strings (`a+b` rather than `a%20b`).\n\nMissing values stay missing.",
    "dependencies": "",
    "options": [
        {
            "name": "fieldName",
            "title": "Text to encode",
            "description": "The text field to encode.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldCustomBlockPublicOption",
            "mandatory": true,
            "inputIndex": 0,
            "defaultValue": null,
            "fieldTypes": [
                "STRING"
            ]
        },
        {
            "name": "outputField",
            "title": "Encoded field name",
            "description": "Name of the new field holding the encoded text. Use the name of the field being encoded to replace it.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.TextCustomBlockPublicOption",
            "mandatory": false,
            "defaultValue": "Quoted text"
        },
        {
            "name": "encodeSlashes",
            "title": "Encode slashes",
            "description": "Encode / as %2F too. Unticked, / is kept.",
            "groupTitle": null,
            "width": "HALF",
            "@visokiotype": "CustomBlockSchema.BooleanCustomBlockPublicOption",
            "defaultValue": false
        },
        {
            "name": "spacesAsPlus",
            "title": "Spaces as +",
            "description": "Encode spaces as + (form style) instead of %20.",
            "groupTitle": null,
