    "icon": "data:image/png;base64,",
    "description": "Loads the transactions of a Slim CD payment gateway account (the SearchTransactions2 report), filtered by date range, customer, amount, card or transaction details, one record per transaction.",
    "category": "Connectors",
    "subcategory": null,
    "tags": [
        "slimcd",
        "slim",
        "payments",
        "gateway",
        "transactions",
        "card payments",
        "reconciliation"
