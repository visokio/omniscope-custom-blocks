        {
            "name": "query",
            "title": "Custom query",
            "description": "A MongoDB filter in JSON, used when \"Whole collection\" is unticked, for example {\"age\": {\"$gte\": 20}} or {\"address.town\": \"Leeds\"}. Names and text need double quotes.",
