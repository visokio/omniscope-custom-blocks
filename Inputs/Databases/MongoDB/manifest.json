    "language": "PYTHON",
    "executableVersion": null,
    "minVersions": [
        null
    ],
    "optionsVersion": 1,
    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "Reads the documents of a MongoDB collection, all of them or those matching a JSON query, one record per document.",
    "category": "Inputs",
    "subcategory": "Databases",
    "tags": [
        "mongodb",
        "database",
        "collection",
        "nosql",
        "documents",
        "connector"
    ],
    "introductoryText": "Reads documents from a MongoDB collection into the workflow: one record per document, one field per top-level key.\n\n**How to set it up**\n\n1. Either enter a **Connection URL** (`mongodb://...` or `mongodb+srv://...`, which can hold the user name, password and options), or leave it empty and enter the **Host** and **Port**, and, if the server needs it, the **User**, **Password** and **Authentication database** (the database the user was created in; `admin` when empty). A connection URL, when given, is used instead of the other connection settings.\n2. Enter the **Database** and **Collection**.\n3. Leave **Whole collection** ticked to read every document, or untick it and type a **Custom query** in JSON, for example `{\"age\": {\"$gte\": 20}}` or `{\"address.town\": \"Leeds\"}`. Optionally set a **Limit**.\n\nNested objects and arrays arrive as JSON text: the community **JSON Normalise** and **JSON Expand fields** blocks turn them into fields. `_id` and other values Omniscope has no type for (ObjectId, UUID) arrive as text, Decimal128 as a decimal number. A key holding numbers in some documents and text in others arrives as text.",
    "dependencies": "pymongo",
    "options": [
        {
            "name": "connection_url",
            "title": "Connection URL",
            "description": "Optional. A MongoDB connection string, for example mongodb+srv://user:password@cluster0.example.net/. When given, the connection and authentication settings below are not used.",
            "groupTitle": "Connection URL",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.PasswordCustomBlockPublicOption",
            "mandatory": false
        },
        {
            "name": "host",
            "title": "Host",
            "description": "The server's name or IP address, for example db.example.com, or 127.0.0.1 for a server on the same machine.",
            "groupTitle": "Connection",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.TextCustomBlockPublicOption",
            "mandatory": true,
            "defaultValue": "127.0.0.1"
        },
        {
            "name": "port",
            "title": "Port",
            "description": "The port MongoDB listens on; usually 27017.",
            "groupTitle": "Connection",
            "width": "HALF",
            "@visokiotype": "CustomBlockSchema.IntegerCustomBlockPublicOption",
            "numMin": 1,
            "numMax": 65535,
            "mandatory": true,
            "defaultValue": 27017,
            "showAsSlider": false
        },
        {
            "name": "user",
            "title": "User",
            "description": "Optional. The user to sign in as; leave empty for a server without authentication.",
            "groupTitle": "Authentication",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.TextCustomBlockPublicOption",
            "mandatory": false,
            "defaultValue": null
        },
        {
            "name": "password",
            "title": "Password",
            "description": "The user's password.",
            "groupTitle": "Authentication",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.PasswordCustomBlockPublicOption",
            "mandatory": false
        },
        {
            "name": "auth_source",
            "title": "Authentication database",
            "description": "Optional. The database the user was created in. Empty: admin.",
            "groupTitle": "Authentication",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.TextCustomBlockPublicOption",
            "mandatory": false,
            "defaultValue": null
        },
        {
            "name": "database",
            "title": "Database",
            "description": "The database that holds the collection.",
            "groupTitle": "Database",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.TextCustomBlockPublicOption",
            "mandatory": true,
            "defaultValue": null
        },
        {
            "name": "collection",
            "title": "Collection",
            "description": "The collection to read.",
            "groupTitle": "Database",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.TextCustomBlockPublicOption",
            "mandatory": true,
            "defaultValue": null
        },
        {
            "name": "full_data",
            "title": "Whole collection",
            "description": "Ticked: every document is read and the custom query is ignored. Unticked: only the documents matching the custom query.",
            "groupTitle": "Query",
