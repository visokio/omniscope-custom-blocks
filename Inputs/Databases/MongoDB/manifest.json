        },
        {
            "name": "limit",
            "title": "Limit",
            "description": "Optional. The most documents to read. Empty or 0: no limit.",
            "groupTitle": "Query",
            "width": "HALF",
            "@visokiotype": "CustomBlockSchema.IntegerCustomBlockPublicOption",
