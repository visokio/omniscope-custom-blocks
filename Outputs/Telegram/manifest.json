{
    "@visokiotype": "CustomBlockSchema.CustomBlockManifest",
    "name": "Send to Telegram",
    "scriptFilename": "script.py",
    "language": "PYTHON",
    "executableVersion": null,
    "minVersions": [
        null
    ],
    "optionsVersion": 1,
    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "Sends the input records as a message to a Telegram chat, group or channel through your bot, as text, a table or JSON.",
    "category": "Outputs",
    "subcategory": "Messenger",
    "tags": [
        "telegram",
        "messenger",
        "message",
        "notification",
        "alert",
        "bot",
        "chat"
    ],
    "introductoryText": "Sends the input records to a Telegram chat, group or channel as a message from your bot: useful for alerts and short summaries at the end of a scheduled workflow.\n\n**How to set it up**: create a bot by messaging **@BotFather** in Telegram (`/newbot`) and paste the token it gives you. Then the **chat ID**: for a private chat, send your bot a message and open `https://api.telegram.org/bot<token>/getUpdates` to read `chat.id`; for a group, add the bot to the group (group IDs start with `-`); for a public channel, add the bot as an administrator and use `@channelname`.\n\n**Formats**\n- **Text**: one line per record, the values separated by spaces.\n- **Table**: a fixed-width table with the field names, so the columns line up.\n- **JSON**: a list of records, numbers as numbers and dates as text.\n\nTelegram allows 4,096 characters per message, so a longer text is sent as several messages, split between records (a table repeats its header on each). With no input records nothing is sent. If Telegram refuses a message the block stops with Telegram's reason.\n\nThe output has one record per message sent: its part number, the records in it, its length and Telegram's message ID.",
    "dependencies": "requests",
    "options": [
        {
            "name": "bot_token",
            "title": "Bot token",
            "description": "The token @BotFather gave when the bot was created, such as 7000000001:AA...",
            "groupTitle": "Connection",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.PasswordCustomBlockPublicOption",
            "mandatory": true
        },
        {
            "name": "chat_id",
            "title": "Chat ID",
            "description": "Where to send: a number (a group's starts with -), or @channelname for a public channel. The bot must be in the group or an administrator of the channel.",
            "groupTitle": "Connection",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.TextCustomBlockPublicOption",
            "mandatory": true,
            "defaultValue": null
        },
        {
            "name": "text_format",
            "title": "Format",
            "description": "How the records are written in the message.",
            "groupTitle": "Text format",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.ChoiceCustomBlockPublicOption",
            "mandatory": true,
            "choices": [
                {
                    "name": null,
                    "title": "JSON",
                    "description": "A list of records: numbers as numbers, dates as text.",
                    "groupTitle": null,
                    "width": null,
                    "@visokiotype": "CustomBlockSchema.ChoiceMetaCustomBlockPublicOption",
                    "value": "JSON",
                    "isSpecial": false
                },
                {
                    "name": null,
                    "title": "Table",
                    "description": "A fixed-width table with the field names.",
                    "groupTitle": null,
