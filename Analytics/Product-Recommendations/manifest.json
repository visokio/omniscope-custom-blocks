{
    "@visokiotype": "CustomBlockSchema.CustomBlockManifest",
    "name": "Product Recommendations",
    "scriptFilename": "script.py",
    "language": "PYTHON",
    "executableVersion": null,
    "minVersions": [
        null
    ],
    "optionsVersion": 1,
    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "Item-to-item recommendations from purchase history: top new products per customer with the reason, and similar products per product.",
    "category": "Analytics",
    "subcategory": "Retail",
    "tags": [
        "recommendations",
        "collaborative filtering",
        "cross-sell",
        "next best product",
        "personalisation",
        "retail",
        "e-commerce",
        "visokio-agents"
    ],
    "introductoryText": "**\"Customers who bought X also bought Y\"**, turned into a ranked list of products each customer has not bought yet.\n\n- **Item-to-item collaborative filtering**: two products are similar when the same customers buy them (cosine similarity), with optional **shrinkage** so pairs seen with few customers count less\n- A customer's score for a product is the sum of its similarity to everything they bought; already-bought products are left out\n- Every recommendation says **\"because you bought\"** which product, for explainable offers and emails\n- The **most similar products per product**, for \"you may also like\" on a product page\n\nProducts bought by fewer customers than the minimum are left out. Works from a plain list of purchases (customer, product); repeats are ignored. Handles up to 8,000 products.",
    "dependencies": "",
    "options": [
        {
            "name": "customer_field",
            "title": "Customer field",
            "description": null,
            "groupTitle": null,
