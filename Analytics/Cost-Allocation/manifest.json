{
    "@visokiotype": "CustomBlockSchema.CustomBlockManifest",
    "name": "Cost Allocation",
    "scriptFilename": "script.py",
    "language": "PYTHON",
    "executableVersion": null,
    "minVersions": [
        null
    ],
    "optionsVersion": 1,
    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "Apportions cost pools to departments, products or customers by drivers, with penny-exact largest-remainder rounding and a list of unallocated pools.",
    "category": "Analytics",
    "subcategory": "Finance",
    "tags": [
        "cost allocation",
        "apportionment",
        "overheads",
        "activity-based costing",
        "recharges",
        "management accounts",
        "rounding",
        "visokio-agents"
    ],
    "introductoryText": "Apportions **cost pools** (IT, facilities, HR, finance) to **receivers** (departments, products, customers, sites) in proportion to a **driver** (headcount, floor area, users, tickets, revenue).\n\n- Each pool names its own driver; a default driver can apply to pools without one\n- Driver values in **long form** (receiver, driver, value) or **wide form** (one numeric column per driver)\n- **Penny-exact rounding** (largest-remainder method): the allocations of every pool add up to the pool exactly, at the number of decimals you choose\n- Pools that cannot be allocated (no driver values, or an amount that is not a number) are listed with the reason\n\nOutputs: every allocation with share and driver value, a summary per receiver (total, from each pool, share of all costs), and the unallocated pools.",
    "dependencies": "",
    "options": [
        {
            "name": "pool_field",
            "title": "Pool name",
            "description": "Names each cost pool, such as IT or Facilities.",
            "groupTitle": "Cost pools (input 1)",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldCustomBlockPublicOption",
            "mandatory": true,
            "inputIndex": 0,
            "defaultValue": null,
            "fieldTypes": []
        },
        {
            "name": "amount_field",
