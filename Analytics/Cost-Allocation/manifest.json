            "groupTitle": "Cost pools (input 1)",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldCustomBlockPublicOption",
            "mandatory": true,
            "inputIndex": 0,
            "defaultValue": null,
            "fieldTypes": []
        },
        {
            "name": "pool_driver_field",
            "title": "Driver for the pool (optional)",
