{
    "@visokiotype": "CustomBlockSchema.CustomBlockManifest",
    "name": "Website Analysis",
    "scriptFilename": "script.py",
    "language": "PYTHON",
    "executableVersion": null,
    "minVersions": [
        "3.9"
    ],
    "optionsVersion": 1,
    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "Follows the links of a website from a start page and lists its pages with their title, heading, text and status, the links on each page, and the images.",
    "category": "Analytics",
    "subcategory": "Website",
    "tags": [
        "http",
        "website",
        "scraping",
        "crawler",
        "links",
        "broken links",
        "seo",
        "analysis"
    ],
    "introductoryText": "Starts at a web page, follows the links that stay on the same site, and lists what it finds.\n\n**Pages** (first output): one record per address visited: its title, first heading (h1), visible text, link depth, HTTP status, content type, the address it ended up at after redirects, and an error for pages that could not be read (a 404, a timeout). Files such as PDFs are listed but not downloaded.\n\n**Links** (second output): every link on every page read, with its text and whether it stays on the site. **Images** (third output): every image on every page read, with its alternative text.\n\n**How to set it up**: enter the **Website address** to start from. **Link depth** is how many clicks away from the start page to go (0 reads only the start page); **Maximum pages** stops the run on a large site. Links to other sites are listed but not visited. By default the block skips pages that the site's robots.txt asks crawlers not to fetch.\n\nThe server running Omniscope fetches the pages, so it needs access to the website. Only analyse sites you are allowed to, and keep the number of pages fetched at once low on sites you don't run.",
    "dependencies": "httpx>=0.23\nbeautifulsoup4",
    "options": [
        {
            "name": "url",
            "title": "Website address",
            "description": "The page to start from, for example https://www.example.com/. https:// is added if you leave it out.",
            "groupTitle": "Website",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.TextCustomBlockPublicOption",
            "mandatory": true,
            "defaultValue": null
        },
        {
            "name": "max_depth",
            "title": "Link depth",
            "description": "How many links to follow away from the start page. 0 reads only the start page.",
            "groupTitle": "Configuration",
            "width": "HALF",
            "@visokiotype": "CustomBlockSchema.IntegerCustomBlockPublicOption",
            "numMin": 0,
            "numMax": null,
            "mandatory": true,
            "defaultValue": 4,
            "showAsSlider": false
        },
        {
            "name": "max_pages",
            "title": "Maximum pages",
            "description": "The run stops after this many pages, so a large site doesn't run for hours.",
            "groupTitle": "Configuration",
            "width": "HALF",
            "@visokiotype": "CustomBlockSchema.IntegerCustomBlockPublicOption",
            "numMin": 1,
            "numMax": null,
            "mandatory": true,
            "defaultValue": 100,
            "showAsSlider": false
        },
        {
            "name": "n_workers",
            "title": "Pages fetched at once",
            "description": "How many pages are requested at the same time (1 to 20).",
            "groupTitle": "Configuration",
            "width": "HALF",
            "@visokiotype": "CustomBlockSchema.IntegerCustomBlockPublicOption",
            "numMin": 1,
            "numMax": 20,
            "mandatory": true,
            "defaultValue": 5,
            "showAsSlider": false
        },
        {
            "name": "respect_robots",
            "title": "Respect robots.txt",
            "description": "Skip pages that the site's robots.txt asks crawlers not to fetch.",
            "groupTitle": "Configuration",
            "width": "HALF",
            "@visokiotype": "CustomBlockSchema.BooleanCustomBlockPublicOption",
            "defaultValue": true
        }
    ],
    "blockOutputs": [
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "Output Data",
            "label": "Pages",
            "displayName": "Pages",
            "tooltip": "One record per address visited: url, text, title, h1, depth, status, content_type, final_url and error."
        },
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "Output Data 2",
            "label": "Links",
            "displayName": "Links",
            "tooltip": "Every link on every page read: parent (the page), url, link_text, and internal (true when it stays on the site)."
        },
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "Output Data 3",
            "label": "Images",
            "displayName": "Images",
            "tooltip": "Every image on every page read: page, image (its address) and alt (its alternative text)."
        }
    ],
    "docker": {
        "@visokiotype": "CustomBlockSchema.DockerCustomBlockPublicOption",
        "customBaseImage": null,
        "useCustomBaseImage": false,
        "customSystemLibraries": null,
        "installVisokioRepLibraries": false
    },
    "designLock": false,
    "apiMode": "BATCH"
}