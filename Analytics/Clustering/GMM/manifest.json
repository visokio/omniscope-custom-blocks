{
    "@visokiotype": "CustomBlockSchema.CustomBlockManifest",
    "name": "Gaussian Mixture Model",
    "scriptFilename": "script.R",
    "language": "R",
    "executableVersion": null,
    "minVersions": [
        null
    ],
    "optionsVersion": 1,
    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": true,
    "icon": "data:image/png;base64,",
    "description": "Clusters records with a Gaussian mixture model on numeric fields, choosing the number of clusters itself, and gives each record its cluster and the probability that it belongs there. A second input can be assigned to the same clusters.",
    "category": "Analytics",
    "subcategory": "Clustering",
    "tags": [
        "gmm",
        "gaussian",
        "mixture",
        "model",
        "clustering",
        "mclust",
        "segmentation",
        "unsupervised"
    ],
    "introductoryText": "Fits a Gaussian mixture model to the numeric fields: each cluster is an oval cloud of points with its own centre, size, shape and tilt, and the block tries 1 up to **Maximum number of clusters** clusters and several cloud shapes, keeping the best by BIC.\n\n**How to set it up**: leave **Use all numeric fields** ticked, or untick it and choose the fields in **Fields to cluster on**. Connect a second input (optional) to assign its records to the clusters found in the first.\n\nOutputs: **Clustered** is the first input with **Cluster** (1, 2, 3... in the order they first appear) and **Cluster probability** (how sure the model is, 0 to 1). **Assigned** is the second input with the same two fields. Records with a missing value in a chosen field keep both fields empty.",
    "dependencies": "",
    "options": [
        {
            "name": "useAllNumericFields",
            "title": "Use all numeric fields",
            "description": "Cluster on every Integer and Decimal field in the first input. Untick to choose the fields in \"Fields to cluster on\".",
            "groupTitle": null,
            "width": null,
            "@visokiotype": "CustomBlockSchema.BooleanCustomBlockPublicOption",
            "defaultValue": true
        },
        {
            "name": "fieldsToUse",
            "title": "Fields to cluster on",
            "description": "The numeric fields to cluster on. Used when \"Use all numeric fields\" is unticked. A second input must have fields with the same names.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldsCustomBlockPublicOption",
            "inputIndex": 0,
            "defaultValue": null,
            "mandatory": false,
            "fieldTypes": []
        },
        {
            "name": "maxClusters",
            "title": "Maximum number of clusters",
            "description": "The block fits models with 1 up to this many clusters and keeps the one with the best BIC (a measure of fit that penalises extra clusters). Larger values take longer.",
            "groupTitle": null,
            "width": "HALF",
            "@visokiotype": "CustomBlockSchema.IntegerCustomBlockPublicOption",
            "numMin": 1,
            "numMax": 30,
            "mandatory": true,
            "defaultValue": 9,
            "showAsSlider": false
        }
    ],
    "blockOutputs": [
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "Output Data",
            "label": "Clustered",
            "displayName": "Clustered records",
            "tooltip": "The first input with Cluster (1, 2, 3...) and Cluster probability (0 to 1); both empty where a chosen field is missing."
        },
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "Output Data 2",
            "label": "Assigned",
            "displayName": "Second input, assigned to clusters",
            "tooltip": "The second input with the cluster each record most probably belongs to, and that probability. Empty unless a second input is connected."
        }
    ],
