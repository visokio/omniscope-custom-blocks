{
    "@visokiotype": "CustomBlockSchema.CustomBlockManifest",
    "name": "DBScan",
    "scriptFilename": "script.py",
    "language": "PYTHON",
    "executableVersion": null,
    "minVersions": [
        null
    ],
    "optionsVersion": 1,
    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": true,
    "icon": "data:image/png;base64,",
    "description": "Groups records into clusters by density (DBSCAN) on numeric fields and marks isolated records as noise. Outputs the input records with a Cluster field added: 1, 2, 3 and so on for clusters, 0 for noise.",
    "category": "Analytics",
    "subcategory": "Clustering",
    "tags": [
        "dbscan",
        "clustering",
        "density",
        "outliers",
        "noise",
        "segmentation"
    ],
    "introductoryText": "Groups records that lie close together on the chosen numeric fields into clusters, and marks records that lie apart from any dense group as noise. The number of clusters is not set in advance, and clusters can have any shape.\n\n**How to set it up**\n\n- Leave **Use all numeric fields** ticked to cluster on every Integer and Decimal field, or untick it and choose the fields in **Fields to cluster on**.\n- Each field is standardised (mean 0, standard deviation 1) first, so fields in different units count equally.\n- Records are neighbours when they are within 0.8 standardised units of each other; a cluster needs at least 5 records close together (DBSCAN with eps 0.8 and minimum 5 samples; these are fixed).\n\n**Output**: the input records with a **Cluster** field: 1, 2, 3... for clusters, **0 for noise**, and empty for records with a missing value in a chosen field. An existing field called Cluster is replaced.\n\nNeeds the scikit-learn Python package (installed on first run if missing).",
    "dependencies": "Cython scikit-learn",
    "options": [
        {
            "name": "useAllNumericFields",
            "title": "Use all numeric fields",
            "description": "Cluster on every Integer and Decimal field in the input. Untick to choose the fields in \"Fields to cluster on\".",
            "groupTitle": "",
            "width": null,
            "@visokiotype": "CustomBlockSchema.BooleanCustomBlockPublicOption",
            "defaultValue": true
        },
        {
            "name": "fieldsToUse",
            "title": "Fields to cluster on",
            "description": "The numeric fields to cluster on. Used when \"Use all numeric fields\" is unticked.",
            "groupTitle": "",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldsCustomBlockPublicOption",
            "inputIndex": 0,
            "defaultValue": null,
            "mandatory": false,
            "fieldTypes": []
        }
    ],
    "blockOutputs": [
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "Output Data",
            "label": "Clustered",
            "displayName": "Clustered records",
            "tooltip": "The input records with a Cluster field: 1, 2, 3... for clusters, 0 for noise, empty where a chosen field is missing."
        }
    ],
    "docker": {
