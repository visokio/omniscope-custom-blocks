            "fieldTypes": []
        },
        {
            "name": "outputDimensions",
            "title": "Number of output dimensions",
            "description": "How many coordinates each node gets: 2 for a scatter chart, 1 for an ordering, 3 for a 3-D view.",
            "groupTitle": "Parameters",
            "width": "HALF",
            "@visokiotype": "CustomBlockSchema.IntegerCustomBlockPublicOption",
            "numMin": 1,
            "numMax": 3,
            "mandatory": true,
            "defaultValue": 2,
            "showAsSlider": false
        },
        {
            "name": "initialDimensions",
            "title": "PCA dimensions",
            "description": "Before t-SNE, each node's connection profile is reduced to this many dimensions with principal component analysis. More keeps more detail but is slower.",
            "groupTitle": "Parameters",
            "width": "HALF",
            "@visokiotype": "CustomBlockSchema.IntegerCustomBlockPublicOption",
            "numMin": 1,
            "numMax": null,
            "mandatory": true,
            "defaultValue": 25,
            "showAsSlider": false
        },
        {
            "name": "perplexity",
            "title": "Perplexity",
            "description": "Roughly how many neighbours each node takes into account. Lower values bring out small, local groups; higher values the overall structure. Must be at most (number of nodes - 1) / 3.",
