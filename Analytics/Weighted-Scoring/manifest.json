    "icon": "data:image/png;base64,",
    "description": "Multi-criteria scorecards: normalise criteria, apply weights, rank alternatives, apply must-pass thresholds and test how sensitive the winner is to the weights.",
    "category": "Analytics",
    "subcategory": "Decision support",
    "tags": [
        "weighted scoring",
        "scorecard",
