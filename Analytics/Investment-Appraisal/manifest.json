            "description": "Period number (0 = today) or the date of each cash flow, to match Timing.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldCustomBlockPublicOption",
            "mandatory": true,
            "inputIndex": 0,
