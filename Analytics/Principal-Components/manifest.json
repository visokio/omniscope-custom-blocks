{
    "@visokiotype": "CustomBlockSchema.CustomBlockManifest",
    "name": "Principal Component Analysis",
    "scriptFilename": "script.py",
    "language": "PYTHON",
    "executableVersion": null,
    "minVersions": [
        null
    ],
    "optionsVersion": 1,
    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "PCA on numeric fields: explained variance, loadings and correlations, automatic or fixed number of components, and scores per row.",
    "category": "Analytics",
    "subcategory": "Statistics",
    "tags": [
        "PCA",
        "principal components",
        "dimension reduction",
        "index",
        "segmentation",
        "factor analysis",
        "statistics",
        "visokio-agents"
    ],
    "introductoryText": "**Principal Component Analysis** summarises many correlated numeric fields with a few components: for building indices, segmentation, score plots of similar items, and reducing predictors before modelling.\n\n- **Standardised** (correlation) PCA by default, so fields in different units count equally; or covariance PCA on centred values\n- Components kept: a **fixed number**, or automatically (eigenvalue above 1 for standardised data, otherwise enough for a target share of variance)\n- **Loadings** with each field's correlation with each component, ranked, and a short label of the main fields per component\n- **Scores** for every row, plus an *unexplained distance* showing rows the kept components describe poorly (unusual profiles)\n- Signs are fixed (largest loading positive) so results are repeatable\n\nRows with a missing value in a chosen field are left out of the fit and get no score.",
    "dependencies": "",
    "options": [
        {
            "name": "fields",
            "title": "Numeric fields",
            "description": "Leave empty to use every numeric field.",
            "groupTitle": null,
            "width": null,
            "@visokiotype": "CustomBlockSchema.FieldsCustomBlockPublicOption",
            "inputIndex": 0,
            "defaultValue": null,
            "mandatory": false,
            "fieldTypes": []
        },
        {
            "name": "standardise",
            "title": "Standardise fields (correlation PCA)",
            "description": "Scales each field to unit variance first, so fields in large units do not dominate. Untick for covariance PCA.",
            "groupTitle": null,
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.BooleanCustomBlockPublicOption",
            "defaultValue": true
        },
        {
            "name": "components",
            "title": "Components to keep",
            "description": "0 = automatic.",
            "groupTitle": null,
            "width": "HALF",
            "@visokiotype": "CustomBlockSchema.IntegerCustomBlockPublicOption",
            "numMin": 0,
            "numMax": 1000,
            "mandatory": false,
            "defaultValue": 0,
            "showAsSlider": false
        },
        {
            "name": "variance_target",
            "title": "Variance to explain (covariance PCA, automatic)",
            "description": null,
            "groupTitle": null,
            "width": "HALF",
            "@visokiotype": "CustomBlockSchema.DoubleCustomBlockPublicOption",
            "numMin": 0.1,
            "numMax": 1.0,
            "mandatory": true,
            "defaultValue": 0.8,
            "showAsSlider": false
        }
    ],
    "blockOutputs": [
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "components",
            "label": "Components",
            "displayName": "Components",
            "tooltip": "Per component: eigenvalue, share and cumulative share of variance, kept."
        },
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "loadings",
            "label": "Loadings",
            "displayName": "Loadings",
            "tooltip": "Per kept component and field: loading, correlation with the component, rank, main fields."
        },
        {
            "@visokiotype": "CustomBlockSchema.BlockOutputPublicOption",
            "id": "scores",
            "label": "Scores",
            "displayName": "Scores",
            "tooltip": "The input with a score per kept component and the unexplained distance."
        }
    ],
    "docker": {
        "@visokiotype": "CustomBlockSchema.DockerCustomBlockPublicOption",
        "customBaseImage": null,
        "useCustomBaseImage": false,
        "customSystemLibraries": null,
        "installVisokioRepLibraries": false
    },
    "designLock": false,
    "apiMode": "BATCH"
}
