    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "Historical and predictive customer lifetime value from orders (BG/NBD and Gamma-Gamma), with probability active, discounting and a holdout check.",
    "category": "Analytics",
    "subcategory": "Marketing",
    "tags": [
        "CLV",
        "customer lifetime value",
        "BG/NBD",
        "Gamma-Gamma",
        "churn",
        "retention",
        "customer analytics",
        "RFM",
        "visokio-agents"
