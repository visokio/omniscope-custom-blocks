    "icon": "data:image/png;base64,",
    "description": "Summarises Likert-scale survey questions: answer distributions, mean scores, top-2-box, net scores and neutral shares, per question and segment.",
    "category": "Analytics",
    "subcategory": "Survey",
    "tags": [
        "survey",
        "likert",
        "engagement",
        "satisfaction",
        "top 2 box",
        "net score",
        "questionnaire",
        "visokio-agents"
