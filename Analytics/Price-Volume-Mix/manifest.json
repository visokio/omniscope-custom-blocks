{
    "@visokiotype": "CustomBlockSchema.CustomBlockManifest",
    "name": "Price-Volume-Mix Bridge",
    "scriptFilename": "script.py",
    "language": "PYTHON",
    "executableVersion": null,
    "minVersions": [
        null
    ],
    "optionsVersion": 1,
    "apiVersion": "VERSION_0",
    "isResourceIntensiveScript": false,
    "showPartitioning": false,
    "icon": "data:image/png;base64,",
    "description": "Decomposes revenue change between two periods into volume, mix, price, new and lost product effects that add up exactly, per item and optional group.",
    "category": "Analytics",
    "subcategory": "Finance",
    "tags": [
        "price volume mix",
        "pvm",
        "variance analysis",
        "revenue bridge",
        "waterfall",
        "finance",
        "commercial",
        "visokio-agents"
    ],
    "introductoryText": "Explains *why* revenue changed between a base period and a current period, the bridge finance and commercial teams present every month or year:\n\n- **Volume**: more or fewer units overall, valued at base prices and base mix\n- **Mix**: customers buying more of the higher- or lower-priced items\n- **Price**: price changes on the units sold in the current period\n- **New products** and **Lost products**: revenue from items sold in only one of the two periods\n\nThe effects are computed per item (product, SKU, service) and **add up exactly** to the revenue change. Optionally per group (region, channel). The bridge output has one row per step with start and end values for a waterfall chart; the item output shows every item's volumes, prices and effects.\n\nChoose the period field and the two values to compare (by default the first and last values in sort order).",
    "dependencies": "",
    "options": [
        {
            "name": "period_field",
            "title": "Period field",
            "description": "For example Year, or a field with values such as FY24 / FY25.",
            "groupTitle": "Data",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldCustomBlockPublicOption",
            "mandatory": true,
            "inputIndex": 0,
            "defaultValue": null,
            "fieldTypes": []
        },
        {
