            "groupTitle": "Data",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldCustomBlockPublicOption",
            "mandatory": true,
            "inputIndex": 0,
            "defaultValue": null,
            "fieldTypes": []
        },
        {
            "name": "volume_field",
            "title": "Volume field",
            "description": "Units, kilograms, contracts...",
            "groupTitle": "Data",
            "width": "ONE",
            "@visokiotype": "CustomBlockSchema.FieldCustomBlockPublicOption",
            "mandatory": true,
            "inputIndex": 0,
            "defaultValue": null,
            "fieldTypes": []
        },
        {
            "name": "revenue_field",
